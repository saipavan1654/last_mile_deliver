# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/last_mile_db?schema=public

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_last_mile_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Notifications Credentials (Optional mock fallback enabled in DEV)
EMAIL_API_KEY=mock_email_api_key
EMAIL_FROM=notifications@lastmile.com
SMS_API_KEY=mock_sms_api_key
