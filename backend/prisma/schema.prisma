generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DELIVERY_AGENT
  ADMIN
}

enum AgentAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum OrderType {
  B2B
  B2C
}

enum PricingType {
  INTRA_ZONE
  INTER_ZONE
}

enum PaymentType {
  PREPAID
  COD
}

enum CODSurchargeType {
  FLAT
  PERCENTAGE
}

enum OrderStatus {
  CREATED
  CONFIRMED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  phone        String
  passwordHash String
  role         Role             @default(CUSTOMER)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  customerProfile CustomerProfile?
  deliveryAgent   DeliveryAgent?
  orders          Order[]          @relation("CustomerOrders")
  trackingEvents  TrackingEvent[]  @relation("ActorTrackingEvents")
  notifications   Notification[]   @relation("CustomerNotifications")

  @@index([email])
  @@index([role])
}

model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryAgent {
  id                 String            @id @default(uuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode       String            @unique
  phone              String
  availabilityStatus AgentAvailability @default(OFFLINE)
  currentLatitude    Float?
  currentLongitude   Float?
  currentZoneId      String?
  currentZone        Zone?             @relation(fields: [currentZoneId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  assignedOrders   Order[]           @relation("AgentOrders")
  deliveryAttempts DeliveryAttempt[]

  @@index([availabilityStatus])
  @@index([currentZoneId])
}

model Zone {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  areas            Area[]
  sourceRateCards  RateCard[]      @relation("SourceZone")
  destRateCards    RateCard[]      @relation("DestZone")
  pickupOrders     Order[]         @relation("PickupZone")
  dropOrders       Order[]         @relation("DropZone")
  agentsInZone     DeliveryAgent[]

  @@index([code])
}

model Area {
  id        String   @id @default(uuid())
  name      String
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pincode   String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  pickupOrders Order[] @relation("PickupArea")
  dropOrders   Order[] @relation("DropArea")

  @@index([pincode])
  @@index([zoneId])
}

model RateCard {
  id                      String      @id @default(uuid())
  orderType               OrderType
  sourceZoneId            String
  sourceZone              Zone        @relation("SourceZone", fields: [sourceZoneId], references: [id])
  destinationZoneId       String
  destinationZone         Zone        @relation("DestZone", fields: [destinationZoneId], references: [id])
  pricingType             PricingType
  baseRate                Float
  perKgRate               Float
  minimumChargeableWeight Float       @default(1.0)
  active                  Boolean     @default(true)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@unique([orderType, sourceZoneId, destinationZoneId])
  @@index([orderType, pricingType])
}

model CODConfiguration {
  id             String           @id @default(uuid())
  orderType      OrderType        @unique
  surchargeType  CODSurchargeType
  surchargeValue Float
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Order {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique
  customerId            String
  customer              User          @relation("CustomerOrders", fields: [customerId], references: [id])
  
  pickupAddress         String
  pickupAreaId          String
  pickupArea            Area          @relation("PickupArea", fields: [pickupAreaId], references: [id])
  pickupZoneId          String
  pickupZone            Zone          @relation("PickupZone", fields: [pickupZoneId], references: [id])
  
  dropAddress           String
  dropAreaId            String
  dropArea              Area          @relation("DropArea", fields: [dropAreaId], references: [id])
  dropZoneId            String
  dropZone              Zone          @relation("DropZone", fields: [dropZoneId], references: [id])

  length                Float
  breadth               Float
  height                Float
  actualWeight          Float
  volumetricWeight      Float
  chargeableWeight      Float

  orderType             OrderType
  paymentType           PaymentType
  
  baseDeliveryCharge    Float
  weightCharge          Float
  codSurcharge          Float
  totalCharge           Float

  currentStatus         OrderStatus   @default(CREATED)
  assignedAgentId       String?
  assignedAgent         DeliveryAgent? @relation("AgentOrders", fields: [assignedAgentId], references: [id])
  scheduledDeliveryDate DateTime

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  trackingEvents        TrackingEvent[]
  deliveryAttempts      DeliveryAttempt[]
  notifications         Notification[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([assignedAgentId])
  @@index([currentStatus])
  @@index([pickupZoneId])
  @@index([dropZoneId])
  @@index([createdAt])
}

model TrackingEvent {
  id             String      @id @default(uuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus String?
  status         OrderStatus
  actorId        String
  actor          User        @relation("ActorTrackingEvents", fields: [actorId], references: [id])
  actorRole      String
  remarks        String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime    @default(now())

  @@index([orderId, createdAt])
}

model DeliveryAttempt {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptNumber Int           @default(1)
  agentId       String
  agent         DeliveryAgent @relation(fields: [agentId], references: [id])
  scheduledDate DateTime
  startedAt     DateTime?     @default(now())
  completedAt   DateTime?
  result        String
  failureReason String?
  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@index([agentId])
}

model Notification {
  id               String              @id @default(uuid())
  orderId          String
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User                @relation("CustomerNotifications", fields: [customerId], references: [id])
  channel          NotificationChannel
  notificationType String
  recipient        String
  message          String
  status           NotificationStatus  @default(PENDING)
  sentAt           DateTime?
  createdAt        DateTime            @default(now())

  @@index([customerId])
  @@index([orderId])
}
